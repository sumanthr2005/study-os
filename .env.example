# STUDY OS — Environment Configuration Template
# Copy this file to .env.local or configure in Vercel Project Settings

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (Neon PostgreSQL - configure in Vercel):
# DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# OPTIONAL EXTERNAL INTEGRATIONS
# -----------------------------------------------------------------------------
# YouTube Data API v3 Key (Optional):
# If not provided, STUDY OS uses its built-in fallback catalogue and simulation engine.
YOUTUBE_API_KEY=""

# AI Provider Configuration (Optional):
# Default: "rule-based" (100% offline deterministic rule engine, no keys required)
# Options: "rule-based" | "gemini" | "openai"
AI_PROVIDER="rule-based"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# -----------------------------------------------------------------------------
# APPLICATION & SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# When false (default in production), unauthenticated API requests are strictly rejected with 401
ALLOW_DEV_FALLBACK="false"
